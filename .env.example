# Copy to .env. Never commit credentials. Environment variables take precedence.
APP_ENV=local
# Set the full origin and subfolder for deployment, e.g. https://hermap.in
SITE_URL=http://localhost/hermap.in
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hermap
DB_USER=
DB_PASSWORD=
SUPPORT_EMAIL=help@hermap.in
# Set these after confirming the actual operator and appointing an officer.
LEGAL_OPERATOR=
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
# Intake is off until deliberately configured. setup-database.php creates local secrets.
REPORT_INTAKE_ENABLED=0
APP_SECRET=
APP_ENCRYPTION_KEY=
ADMIN_USERNAME=amit
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
PUBLIC_MIN_REPORTS=5
PUBLICATION_DELAY_HOURS=48
